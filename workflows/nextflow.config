process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    withName: FASTQC   { container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'; cpus = 2 }
    withName: FASTP    { container = 'quay.io/biocontainers/fastp:0.23.4--h5f740d0_0'; cpus = 4 }

    withName: 'BWA_MEM_SORT|INDEX_SORTED|BAM_SAMTOOLS_QC|BAM_CHECK' { container = 'quay.io/biocontainers/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:219b6c272b25e7e642ae3ff0bf0c5c81a5135ab4-0'; cpus = 4 }
    withName: 'MARK_DUPLICATES|BAM_VALIDATE|INSERT_SIZE|HS_METRICS|BASE_RECALIBRATOR|APPLY_BQSR|HAPLOTYPECALLER|GENOTYPE_GVCFS|SELECT_FILTER|MERGE_LABEL|VALIDATE_VCF' { container = 'broadinstitute/gatk:4.5.0.0'; cpus = 2 }
    withName: 'BCFTOOLS_PASS' { container = 'quay.io/biocontainers/bcftools:1.20--h8b25389_0'; cpus = 2 }
}

profiles {
    docker { docker.enabled = true }
    conda  {
        conda.enabled = true
        process.conda = 'bioconda::fastqc=0.12.1 bioconda::fastp=0.23.4'
    }
}

report   { enabled = true; file = 'results/nextflow/report.html'; overwrite = true }
trace    { enabled = true; file = 'results/nextflow/trace.tsv'; overwrite = true }
timeline { enabled = true; file = 'results/nextflow/timeline.html'; overwrite = true }
